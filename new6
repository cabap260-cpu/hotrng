---------------------------------------------------------------- Auto Pray (3 cách: remote / prompt / nút GUI)
local function pressButton(b)
    local n = 0
    if getconnections then
        for _, ev in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
            local cs = {}
            pcall(function() cs = getconnections(b[ev]) end)
            for _, c in ipairs(cs) do
                pcall(function() c:Fire() end)
                n += 1
            end
            if n > 0 then break end
        end
    end
    if n == 0 and firesignal then
        pcall(function() firesignal(b.MouseButton1Click) n += 1 end)
    end
    return n > 0
end

local function findPrayButtons()
    local out = {}
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and not inOurGui(d) then
            local hit = matches(d.Name, CONFIG.PRAY_PATTERNS)
                or (d:IsA("TextButton") and matches(d.Text, CONFIG.PRAY_PATTERNS))
            if not hit then
                for _, c in ipairs(d:GetChildren()) do
                    if c:IsA("TextLabel") and matches(c.Text, CONFIG.PRAY_PATTERNS) then hit = true break end
                end
            end
            if hit then out[#out+1] = d end
        end
    end
    return out
end

local function prayVia(method)
    local fired = 0
    if method == "remote" then
        for _, r in ipairs(findRemotes(CONFIG.PRAY_PATTERNS)) do
            fired += 1
            if r:IsA("RemoteEvent") then
                pcall(r.FireServer, r)
            else
                task.spawn(function()
                    local ok, res = pcall(r.InvokeServer, r)
                    if ok and res ~= nil then setNotice("return: " .. tostring(res)) end
                end)
            end
            task.wait(rand(0.2, 0.5))
        end
    elseif method == "button" then
        for _, b in ipairs(findPrayButtons()) do
            if pressButton(b) then fired += 1 end
            task.wait(rand(0.2, 0.5))
        end
    elseif method == "prompt" then
        local hrp = root()
        local best, bestPart, bestD
        for _, it in ipairs(findInteractables(CONFIG.PRAY_PATTERNS, workspace)) do
            local part = partOf(it)
            if hrp and part then
                local d = (hrp.Position - part.Position).Magnitude
                if d <= CONFIG.PRAY_MAX_DIST and (not bestD or d < bestD) then
                    best, bestPart, bestD = it, part, d
                end
            end
        end
        if best then
            local reach = math.max((best.MaxActivationDistance or 10) - 3, 4)
            local near = bestD <= reach or walkTo(bestPart, reach, CONFIG.WALK_TIMEOUT)
            if near then
                task.wait(rand(0.4, 1.0))
                if fireTarget(best) then fired += 1 end
            end
        end
    end
    return fired
end

local function waitNotice(before)
    local t0 = tick()
    while tick() - t0 < CONFIG.PRAY_WAIT_NOTICE and prayNotice.t <= before do
        task.wait(0.2)
    end
    return prayNotice.t > before
end

-- liệt kê những gì server/GUI phản hồi sau khi pray (để biết game thật sự dùng gì)
local function diagnose(startT)
    local seen, list = {}, {}
    for _, e in ipairs(recent) do
        if e.t >= startT and not seen[e.s] and #list < 5 then
            seen[e.s] = true
            list[#list+1] = string.sub(e.s, 1, 40)
        end
    end
    if #list > 0 then
        log("sau pray thấy: " .. table.concat(list, " | "))
    else
        log("sau pray: server/GUI không phản hồi gì")
    end
end

local prayMethod
local function doPray()
    local order = {}
    if prayMethod then order[1] = prayMethod end
    for _, m in ipairs(CONFIG.PRAY_METHODS) do
        if m ~= prayMethod then order[#order+1] = m end
    end
    local triedAny = false
    for _, m in ipairs(order) do
        local before, startT = prayNotice.t, tick()
        local fired = prayVia(m)
        if fired > 0 then
            triedAny = true
            if waitNotice(before) then
                prayMethod = m
                log("pray OK [" .. m .. "]: " .. prayNotice.text)
                return true
            end
            log("pray [" .. m .. "] x" .. fired .. ": không có thông báo")
            diagnose(startT)
            task.wait(rand(1, 2))
        end
    end
    if not triedAny then
        log("pray: không thấy remote/prompt/nút khớp -> bấm 'Scan Pray'")
    end
    return false
end

task.spawn(function()
    local misses = 0
    while alive do
        task.wait(jitter(CONFIG.PRAY_INTERVAL, 0.2) * math.min(2 ^ misses, 12))
        if State.AutoPray then
            local ok = doPray()
            misses = ok and 0 or math.min(misses + 1, 4)
        else
            misses = 0
        end
    end
end)

-- Quét mọi thứ có tên/chữ giống "pray" -> ghi vào log (bấm Copy Log để gửi)
function scanPray()
    local n = 0
    local pats = CONFIG.PRAY_PATTERNS
    local roots = { workspace, ReplicatedStorage, LP:FindFirstChild("PlayerGui"), LP:FindFirstChild("Backpack") }
    for _, r in ipairs(roots) do
        for _, d in ipairs(r:GetDescendants()) do
            if n >= 40 then break end
            if not inOurGui(d) then
                local hit = matches(d.Name, pats)
                if not hit and (d:IsA("TextLabel") or d:IsA("TextButton")) then
                    hit = matches(d.Text, pats)
                end
                if hit then
                    n += 1
                    log("scan: [" .. d.ClassName .. "] " .. d:GetFullName())
                end
            end
        end
    end
    log("scan xong: " .. n .. " mục. Bấm Copy Log để gửi cho mình")
end

---------------------------------------------------------------- Auto Pumpkin (Walk hoặc Tele)
local function findPumpkinTargets()
    local out = {}
    for _, it in ipairs(findInteractables(CONFIG.PUMPKIN_PATTERNS, workspace)) do
        out[#out+1] = { inst = it, part = partOf(it), touch = false }
    end
    if #out == 0 then -- nhặt bằng chạm: tới gần là tự nhặt
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") and d:FindFirstChildOfClass("TouchTransmitter")
               and (matches(d.Name, CONFIG.PUMPKIN_PATTERNS)
                    or (d.Parent and matches(d.Parent.Name, CONFIG.PUMPKIN_PATTERNS))) then
                out[#out+1] = { inst = d, part = d, touch = true }
            end
        end
    end
    return out
end

-- Chế độ TELE: dịch chuyển tới quả rồi quay lại chỗ cũ (NGUY CƠ BAN)
local function teleCollect(best)
    local hrp = root()
    if not (hrp and best.part and best.part.Parent) then return false end
    local back = hrp.CFrame
    hrp.CFrame = best.part.CFrame + Vector3.new(0, 3, 0)
    task.wait(rand(0.4, 0.9))
    if not best.touch then fireTarget(best.inst) else task.wait(0.3) end
    task.wait(rand(0.3, 0.7))
    local hrp2 = root()
    if hrp2 then hrp2.CFrame = back end
    return true
end

local pumpkinSkip, pumpkinTimes, pumpkinCount = {}, {}, 0
task.spawn(function()
    while alive do
        if State.PumpkinTele then
            task.wait(rand(3, 6))
        else
            task.wait(rand(CONFIG.PUMPKIN_SCAN_MIN, CONFIG.PUMPKIN_SCAN_MAX))
        end
        if not (State.AutoPumpkin and root()) then continue end

        local now = tick()
        for i = #pumpkinTimes, 1, -1 do
            if now - pumpkinTimes[i] > 60 then table.remove(pumpkinTimes, i) end
        end
        local cap = State.PumpkinTele and CONFIG.PUMPKIN_TELE_MAX_PER_MIN or CONFIG.PUMPKIN_MAX_PER_MIN
        if #pumpkinTimes >= cap then
            log("pumpkin: đạt giới hạn/phút, nghỉ")
            continue
        end

        local hrp = root()
        local best, bestD
        for _, t in ipairs(findPumpkinTargets()) do
            local skipUntil = pumpkinSkip[t.inst]
            if t.part and t.inst.Parent and not (skipUntil and skipUntil > now) then
                local d = (hrp.Position - t.part.Position).Magnitude
                if d <= CONFIG.PUMPKIN_MAX_DIST and (not bestD or d < bestD) then
                    best, bestD = t, d
                end
            end
        end
        if not best then log("pumpkin: none found") continue end

        local ok = false
        if State.PumpkinTele then
            log("⚠ pumpkin TELE (nguy cơ BAN)")
            ok = teleCollect(best)
        else
            local reach = best.touch and 2 or math.max((best.inst.MaxActivationDistance or 10) - 3, 4)
            ok = walkTo(best.part, reach, CONFIG.WALK_TIMEOUT)
            if ok and State.AutoPumpkin and best.inst.Parent then
                task.wait(rand(0.5, 1.4))
                if not best.touch then fireTarget(best.inst) end
            else
                ok = false
            end
        end

        if ok then
            pumpkinTimes[#pumpkinTimes+1] = tick()
            pumpkinCount += 1
            log("pumpkin #" .. pumpkinCount .. " (" .. #pumpkinTimes .. "/" .. cap .. " phút này)")
            if pumpkinCount % CONFIG.PUMPKIN_REST_EVERY == 0 then
                log("pumpkin: nghỉ ngắn")
                task.wait(rand(15, 40))
            end
        else
            pumpkinSkip[best.inst] = tick() + 30 -- kẹt/không tới được: bỏ 30s
        end
    end
end)

---------------------------------------------------------------- Redeem codes (chỉ nhập code acc chưa dùng)
local HttpService = game:GetService("HttpService")
local CODES_FILE = "HotsRNG_codes.json"
local uid = tostring(LP.UserId)
local codeDB = {}
pcall(function()
    if isfile and readfile and isfile(CODES_FILE) then
        codeDB = HttpService:JSONDecode(readfile(CODES_FILE))
    end
end)
if type(codeDB) ~= "table" then codeDB = {} end
local function saveDB()
    if writefile then pcall(writefile, CODES_FILE, HttpService:JSONEncode(codeDB)) end
end
local function codeStatus(code) return codeDB[uid] and codeDB[uid][code] end
local function setCodeStatus(code, s)
    codeDB[uid] = codeDB[uid] or {}
    codeDB[uid][code] = s
    saveDB()
end
local function resetCodes()
    codeDB[uid] = {}
    saveDB()
    log("đã xoá lịch sử code của acc này")
end

local function gatherCodes(extra)
    local list, seen = {}, {}
    local function add(c)
        c = tostring(c):match("^%s*(.-)%s*$")
        if c ~= "" and not seen[c] then seen[c] = true list[#list+1] = c end
    end
    for _, c in ipairs(extra or {}) do add(c) end
    for _, c in ipairs(CONFIG.CODES) do add(c) end
    if CONFIG.CODES_URL ~= "" then
        local ok, body = pcall(function() return game:HttpGet(CONFIG.CODES_URL) end)
        if ok and type(body) == "string" then
            for line in string.gmatch(body, "[^\r\n]+") do
                if not line:match("^%s*#") then add(line) end
            end
        else
            log("không tải được CODES_URL")
        end
    end
    return list
end

local function findCodeBox()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextBox") and not inOurGui(d)
           and (matches(d.Name, { "code" }) or matches(d.PlaceholderText, { "code" })) then
            return d
        end
    end
    return nil
end

local function findRedeemButton(box)
    local anc = box.Parent
    for _ = 1, 4 do
        if not anc then break end
        for _, d in ipairs(anc:GetDescendants()) do
            if d:IsA("TextButton") or d:IsA("ImageButton") then
                local hit = matches(d.Name, CONFIG.REDEEM_BUTTON_PATTERNS)
                    or (d:IsA("TextButton") and matches(d.Text, CONFIG.REDEEM_BUTTON_PATTERNS))
                if not hit then
                    for _, c in ipairs(d:GetChildren()) do
                        if c:IsA("TextLabel") and matches(c.Text, CONFIG.REDEEM_BUTTON_PATTERNS) then hit = true break end
                    end
                end
                if hit then return d end
            end
        end
        anc = anc.Parent
    end
    return nil
end

local function submitGui(code)
    local box = findCodeBox()
    if not box then return false end
    box.Text = code
    task.wait(rand(0.3, 0.7))
    local btn = findRedeemButton(box)
    if btn and pressButton(btn) then return true end
    local n = 0 -- không thấy nút: giả lập bấm Enter
    pcall(function()
        for _, c in ipairs(getconnections(box.FocusLost)) do
            c:Fire(true)
            n += 1
        end
    end)
    return n > 0
end

local function submitRemote(code)
    local n = 0
    for _, r in ipairs(findRemotes(CONFIG.CODE_REMOTE_PATTERNS)) do
        n += 1
        if r:IsA("RemoteEvent") then
            pcall(r.FireServer, r, code)
        else
            task.spawn(function()
                local ok, res = pcall(r.InvokeServer, r, code)
                if ok and res ~= nil then record("T:" .. tostring(res)) end
            end)
        end
        task.wait(rand(0.2, 0.5))
    end
    return n
end

-- đọc phản hồi (chữ GUI / chat / remote / giá trị trả về) sau khi gửi code
local function classify(startT)
    local texts = {}
    for _, e in ipairs(recent) do
        local k = string.sub(e.s, 1, 2)
        if e.t >= startT and (k == "G:" or k == "T:" or k == "C:") then texts[#texts+1] = e.s end
    end
    local all = table.concat(texts, " | ")
    if all == "" then return "unknown", "" end
    if matches(all, CONFIG.CODE_USED_PATTERNS) then return "already", all end
    if matches(all, CONFIG.CODE_BAD_PATTERNS) then return "invalid", all end
    if matches(all, CONFIG.CODE_OK_PATTERNS) then return "ok", all end
    return "unknown", all
end

local function tryRedeem(code)
    local lastTxt = ""
    for _, m in ipairs(CONFIG.REDEEM_METHODS) do
        local startT = tick()
        local sent = false
        if m == "gui" then sent = submitGui(code) else sent = submitRemote(code) > 0 end
        if sent then
            task.wait(CONFIG.REDEEM_WAIT)
            local v, txt = classify(startT)
            if v ~= "unknown" then return v, m, txt end
            lastTxt = txt
        end
    end
    return "unknown", "", lastTxt
end

local redeeming = false
local function redeemAll(extra)
    if redeeming then log("đang redeem, đợi xong đã") return end
    redeeming = true
    local okRun, err = pcall(function()
        if not (writefile and readfile) then log("executor không có writefile: sẽ không nhớ code đã nhập") end
        local list = gatherCodes(extra)
        local todo = {}
        for _, c in ipairs(list) do
            local s = codeStatus(c)
            if not s or s == "unknown" then todo[#todo+1] = c end
        end
        if #todo == 0 then
            log("redeem: không còn code mới (" .. #list .. " code đã xử lý)")
            return
        end
        local cnt = { ok = 0, already = 0, invalid = 0, unknown = 0 }
        for i, code in ipairs(todo) do
            if not alive then break end
            log(("redeem %d/%d: %s"):format(i, #todo, code))
            local v, m, txt = tryRedeem(code)
            cnt[v] += 1
            if v ~= "unknown" then
                setCodeStatus(code, v)
                log(("%s -> %s [%s]"):format(code, v, m))
            else
                log(("%s -> không rõ kết quả. Thấy: %s"):format(code, string.sub(txt, 1, 70)))
            end
            task.wait(rand(2.5, 5))
        end
        log(("redeem xong: ok %d | đã dùng %d | sai/hết hạn %d | không rõ %d"):format(
            cnt.ok, cnt.already, cnt.invalid, cnt.unknown))
    end)
    if not okRun then log("redeem lỗi: " .. tostring(err)) end
    redeeming = false
end

---------------------------------------------------------------- Fly (chậm, mượt)
local flyBV, flyBG, flyUp, flyDown = nil, nil, false, false
local flyVel = Vector3.zero
local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    flyVel = Vector3.zero
    local _, hum = root()
    if hum then hum.PlatformStand = false end
end
local function startFly()
    local hrp, hum = root()
    if not hrp then return end
    stopFly()
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyBG.P = 1e4
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp
    hum.PlatformStand = true
end
track(RunService.RenderStepped:Connect(function(dt)
    if not State.Fly then return end
    local hrp, hum = root()
    if not (hrp and hum and flyBV and flyBV.Parent) then return end
    local cam = workspace.CurrentCamera
    local move = hum.MoveDirection
    local target = Vector3.zero
    if move.Magnitude > 0 then
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        local fwd = flatLook.Magnitude > 0 and move:Dot(flatLook.Unit) or 0
        local side = flatRight.Magnitude > 0 and move:Dot(flatRight.Unit) or 0
        target = look * fwd + right * side
    end
    if flyUp then target += Vector3.yAxis end
    if flyDown then target -= Vector3.yAxis end
    target = target * CONFIG.FLY_SPEED
    -- giới hạn tốc độ lên/xuống
    local y = math.clamp(target.Y, -CONFIG.FLY_VERTICAL, CONFIG.FLY_VERTICAL)
    target = Vector3.new(target.X, y, target.Z)
    -- tăng/giảm tốc mượt
    flyVel = flyVel:Lerp(target, math.clamp(dt * CONFIG.FLY_ACCEL, 0, 1))
    flyBV.Velocity = flyVel
    flyBG.CFrame = cam.CFrame
end))
track(LP.CharacterAdded:Connect(function()
    task.wait(1)
    if State.Fly then startFly() end
end))
local function setFly(v)
    State.Fly = v
    if v then startFly() else stopFly() end
end

