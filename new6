---------------------------------------------------------------- helpers: scan / fire / walk
local function fireTarget(inst)
    if inst:IsA("ProximityPrompt") then
        pcall(function() if inst.HoldDuration > 0 then inst.HoldDuration = 0 end end)
        if fireproximityprompt then fireproximityprompt(inst) return true end
    elseif inst:IsA("ClickDetector") then
        if fireclickdetector then fireclickdetector(inst) return true end
    end
    return false
end

local function findInteractables(patterns, scope)
    local out = {}
    for _, d in ipairs(scope:GetDescendants()) do
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
            local p = d.Parent
            if matches(d.Name, patterns) or (p and matches(p.Name, patterns))
               or (p and p.Parent and matches(p.Parent.Name, patterns)) then
                out[#out+1] = d
            end
        end
    end
    return out
end

local function findRemotes(patterns)
    local out = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and matches(d.Name, patterns) then
            out[#out+1] = d
        end
    end
    return out
end

local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    local p = inst.Parent
    while p and not p:IsA("BasePart") do
        if p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
        p = p.Parent
    end
    return p
end

-- Noclip (CanCollide=false cho nhân vật; tự khôi phục khi tắt)
local noclipSaved, noclipAuto = {}, false
track(RunService.Stepped:Connect(function()
    local want = noclipAuto or State.Noclip
    if not want then
        if next(noclipSaved) then
            for p, was in pairs(noclipSaved) do if p.Parent then p.CanCollide = was end end
            noclipSaved = {}
        end
        return
    end
    local c = LP.Character
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            if noclipSaved[p] == nil then noclipSaved[p] = p.CanCollide end
            p.CanCollide = false
        end
    end
end))

-- Khi kẹt: noclip + trượt chậm thẳng tới mục tiêu (giữ độ cao để không rơi xuyên map)
local function noclipWalk(part, stopDist, timeout)
    noclipAuto = true
    local ok, t0 = false, tick()
    local lift = stopDist > 4 and 3 or 0
    while alive and tick() - t0 < timeout do
        local hrp = root()
        if not (hrp and part.Parent) then break end
        if (hrp.Position - part.Position).Magnitude <= stopDist then ok = true break end
        local delta = (part.Position + Vector3.new(0, lift, 0)) - hrp.Position
        local dt = task.wait()
        if delta.Magnitude > 0.01 then
            local step = math.min(delta.Magnitude, CONFIG.NOCLIP_SPEED * dt)
            hrp.CFrame = hrp.CFrame + delta.Unit * step
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    noclipAuto = false
    return ok
end

-- Đi bộ thật bằng Humanoid:MoveTo; kẹt -> nhảy -> noclip
local function walkTo(part, stopDist, timeout)
    if State.Fly then log("tắt Fly để tự đi bộ") return false end
    local hrp, hum = root()
    if not (hrp and hum and part) then return false end
    local t0 = tick()
    local lastPos, lastCheck, stuck = hrp.Position, tick(), 0
    while alive and tick() - t0 < timeout do
        hrp, hum = root()
        if not (hrp and hum and part.Parent) then return false end
        if (hrp.Position - part.Position).Magnitude <= stopDist then
            hum:MoveTo(hrp.Position)
            return true
        end
        hum:MoveTo(part.Position)
        task.wait(0.25)
        if tick() - lastCheck >= 1.5 then
            if hrp.Parent and (hrp.Position - lastPos).Magnitude < 1 then
                stuck += 1
                if stuck == 1 then
                    hum.Jump = true
                elseif CONFIG.AUTO_NOCLIP then
                    log("kẹt vật cản -> noclip")
                    return noclipWalk(part, stopDist, math.max(timeout - (tick() - t0), 8))
                end
            else
                stuck = 0
            end
            lastPos, lastCheck = hrp.Position, tick()
        end
    end
    return false
end

---------------------------------------------------------------- Notification / event recorder
local prayNotice = { t = 0, text = "" }
local recent = {}   -- sự kiện gần đây (remote server / đổi chữ GUI) để chẩn đoán
local function record(s)
    recent[#recent+1] = { t = tick(), s = s }
    if #recent > 80 then table.remove(recent, 1) end
end
local function setNotice(text)
    prayNotice.t = tick()
    prayNotice.text = tostring(text)
    log("notice: " .. prayNotice.text)
end
local function inOurGui(d)
    local p = d
    while p do
        if p.Name == "HotsRNG_GUI" then return true end
        p = p.Parent
    end
    return false
end

local function argsToStr(...)
    local t = {}
    for i = 1, select("#", ...) do t[#t+1] = tostring((select(i, ...))) end
    return string.sub(table.concat(t, ", "), 1, 90)
end

-- RemoteEvent từ server (thông báo thường đi qua đây)
local function hookRemote(r)
    if not r:IsA("RemoteEvent") then return end
    pcall(function()
        track(r.OnClientEvent:Connect(function(...)
            record("R:" .. r.Name)
            if State.Spy then log("[S] " .. r.Name .. "(" .. argsToStr(...) .. ")") end
            for i = 1, select("#", ...) do
                local a = select(i, ...)
                if type(a) == "string" then
                    record("T:" .. a)
                    if matches(a, CONFIG.PRAY_NOTICE_PATTERNS) then setNotice(a) end
                end
            end
        end))
    end)
end
for _, d in ipairs(ReplicatedStorage:GetDescendants()) do hookRemote(d) end
track(ReplicatedStorage.DescendantAdded:Connect(hookRemote))

