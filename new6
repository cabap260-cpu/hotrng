local function giveTool(name, onActivate)
    local bp = LP:FindFirstChildOfClass("Backpack")
    if not bp then return end
    if bp:FindFirstChild(name) or (LP.Character and LP.Character:FindFirstChild(name)) then return end
    local tool = Instance.new("Tool")
    tool.Name = name
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Activated:Connect(function()
        local mouse = LP:GetMouse()
        if mouse and mouse.Hit then onActivate(mouse.Hit.Position) end
    end)
    tool.Parent = bp
end

