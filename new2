end)

---------------------------------------------------------------- helpers: scan / fire
local function fireTarget(inst)
    if inst:IsA("ProximityPrompt") then
        if fireproximityprompt then fireproximityprompt(inst) return true end
    elseif inst:IsA("ClickDetector") then
        if fireclickdetector then fireclickdetector(inst) return true end
    elseif inst:IsA("RemoteEvent") then
        inst:FireServer() return true
    elseif inst:IsA("RemoteFunction") then
        task.spawn(function() pcall(inst.InvokeServer, inst) end) return true
    end
    return false
end

local function findInteractables(patterns, scope)
    local out = {}
    for _, d in ipairs(scope:GetDescendants()) do
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
            local p = d.Parent
            if matches(d.Name, patterns) or (p and matches(p.Name, patterns))
               or (p and p.Parent and matches(p.Parent.Name, patterns)) then
                out[#out+1] = d
            end
        end
    end
    return out
end

local function findRemotes(patterns)
    local out = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and matches(d.Name, patterns) then
            out[#out+1] = d
        end
    end
    return out
end

local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    local p = inst.Parent
    while p and not p:IsA("BasePart") do
        if p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
        p = p.Parent
    end
    return p
end

---------------------------------------------------------------- Auto Pray
task.spawn(function()
    while alive do
        task.wait(CONFIG.PRAY_INTERVAL)
        if State.AutoPray then
            local fired = 0
            for _, r in ipairs(findRemotes(CONFIG.PRAY_PATTERNS)) do
                if fireTarget(r) then fired += 1 end
            end
            if fired == 0 then
                local hrp = root()
                for _, it in ipairs(findInteractables(CONFIG.PRAY_PATTERNS, workspace)) do
                    local part = partOf(it)
                    if hrp and part and (hrp.Position - part.Position).Magnitude <= 60 then
                        if fireTarget(it) then fired += 1 end
                    end
                end
            end
            log(fired > 0 and ("pray fired x" .. fired) or "pray: no remote/prompt matched")
        end
    end
end)

---------------------------------------------------------------- Auto Pumpkin (Halloween)
local function collectPumpkin(obj)
    local hrp = root()
    local part = partOf(obj)
    if not (hrp and part) then return false end
    if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
        local back = hrp.CFrame
        hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.15)
        fireTarget(obj)
        task.wait(0.15)
        hrp.CFrame = back
        return true
    end
    return false
end

task.spawn(function()
    while alive do
        task.wait(CONFIG.PUMPKIN_SCAN)
        if State.AutoPumpkin and root() then
            local n = 0
            local list = findInteractables(CONFIG.PUMPKIN_PATTERNS, workspace)
            for _, it in ipairs(list) do
                if not State.AutoPumpkin or not it.Parent then break end
                if collectPumpkin(it) then n += 1 end
            end
            -- fallback: touch-based pickups
            if #list == 0 and firetouchinterest then
                local hrp = root()
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d:IsA("BasePart") and d:FindFirstChildOfClass("TouchTransmitter")
                       and (matches(d.Name, CONFIG.PUMPKIN_PATTERNS)
                            or (d.Parent and matches(d.Parent.Name, CONFIG.PUMPKIN_PATTERNS))) then
                        pcall(function()
                            firetouchinterest(hrp, d, 0)
                            firetouchinterest(hrp, d, 1)
                        end)
                        n += 1
                    end
                end
            end
            log(n > 0 and ("pumpkin collected x" .. n) or "pumpkin: none found")
        end
    end
end)

---------------------------------------------------------------- Redeem codes
local function redeemCodes(codes)
    codes = codes or CONFIG.CODES
    if #codes == 0 then log("no codes to redeem") return end
    local remotes = findRemotes(CONFIG.CODE_REMOTE_PATTERNS)
    if #remotes == 0 then log("code remote not found") return end
    local used = 0
    for _, code in ipairs(codes) do
        for _, r in ipairs(remotes) do
            pcall(function()
                if r:IsA("RemoteEvent") then r:FireServer(code) else r:InvokeServer(code) end
            end)
        end
        used += 1
        task.wait(0.8)
    end
    log("redeem sent: " .. used .. " code(s) via " .. #remotes .. " remote(s)")
end

---------------------------------------------------------------- Fly
local flyBV, flyBG, flyUp, flyDown = nil, nil, false, false
local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    local _, hum = root()
    if hum then hum.PlatformStand = false end
end
local function startFly()
    local hrp, hum = root()
    if not hrp then return end
    stopFly()
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyBG.P = 1e4
    flyBG.Parent = hrp
    hum.PlatformStand = true
end
track(RunService.RenderStepped:Connect(function()
    if not State.Fly then return end
    local hrp, hum = root()
    if not (hrp and hum and flyBV and flyBV.Parent) then return end
    local cam = workspace.CurrentCamera
    local move = hum.MoveDirection
    local vel = Vector3.zero
    if move.Magnitude > 0 then
        -- project movement onto camera so looking up/down changes altitude
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local fwd = move:Dot(Vector3.new(look.X, 0, look.Z).Unit)
        local side = move:Dot(Vector3.new(right.X, 0, right.Z).Unit)
        vel = look * fwd + right * side
    end
    if flyUp then vel += Vector3.yAxis end
    if flyDown then vel -= Vector3.yAxis end
    flyBV.Velocity = vel * CONFIG.FLY_SPEED
    flyBG.CFrame = cam.CFrame
end))
track(LP.CharacterAdded:Connect(function()
    task.wait(1)
    if State.Fly then startFly() end
end))
local function setFly(v)
    State.Fly = v
    if v then startFly() else stopFly() end
end

---------------------------------------------------------------- Teleport tool
local function giveTpTool()
    local bp = LP:FindFirstChildOfClass("Backpack")
    if not bp then return end
    if bp:FindFirstChild("Teleport Tool") or (LP.Character and LP.Character:FindFirstChild("Teleport Tool")) then return end
    local tool = Instance.new("Tool")
    tool.Name = "Teleport Tool"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Activated:Connect(function()
        local hrp = root()
        local mouse = LP:GetMouse()
        if hrp and mouse and mouse.Hit then
            hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
        end
    end)
    tool.Parent = bp
end
track(LP.CharacterAdded:Connect(function() task.wait(1) giveTpTool() end))

