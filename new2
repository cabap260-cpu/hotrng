---------------------------------------------------------------- Anti Kick
do
    local ok, err = pcall(function()
        assert(hookmetamethod and getnamecallmethod, "hookmetamethod unsupported")
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if self == LP and typeof(method) == "string" and lower(method) == "kick" then
                return
            end
            return oldNamecall(self, ...)
        end)
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, key)
            if self == LP and typeof(key) == "string" and lower(key) == "kick" then
                return function() end
            end
            return oldIndex(self, key)
        end)
    end)
    if not ok then warn("[HotsRNG] AntiKick not active: " .. tostring(err)) end
end

---------------------------------------------------------------- Auto Rejoin
local function queueReload()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport)
    if not q then return end
    local code
    if CONFIG.SCRIPT_URL ~= "" then
        code = ('loadstring(game:HttpGet("%s"))()'):format(CONFIG.SCRIPT_URL)
    else
        code = ('local f=isfile and isfile("%s") and readfile("%s"); if f then loadstring(f)() end')
            :format(CONFIG.SCRIPT_FILE, CONFIG.SCRIPT_FILE)
    end
    pcall(q, code)
end
local startTick = tick()
task.spawn(function()
    while alive do
        task.wait(5)
        if State.AutoRejoin and tick() - startTick >= CONFIG.REJOIN_MINUTES * 60 then
            queueReload()
            local ok = pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
            startTick = tick() + 30 -- retry delay if teleport failed
            if not ok then log("rejoin failed, retrying") end
        end
    end
end)
