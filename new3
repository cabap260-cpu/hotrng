local function toggle(text, order, key, onChange)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 30)
    b.LayoutOrder = order
    b.Font = Enum.Font.Gotham
    b.TextSize = 14
    b.TextColor3 = Color3.new(1, 1, 1)
    b.BorderSizePixel = 0
    b.Parent = frame
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local function refresh()
        b.Text = text .. ": " .. (State[key] and "ON" or "OFF")
        b.BackgroundColor3 = State[key] and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(70, 70, 80)
    end
    b.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        refresh()
        if onChange then onChange(State[key]) end
    end)
    refresh()
end

