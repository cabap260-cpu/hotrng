-- Auto Rejoin moi 15 phut
task.spawn(function()
    local t = 0
    while task.wait(1) do
        if State.Rejoin then
            t += 1
            if t >= REJOIN_SECONDS then
                t = 0
                pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
            end
        else
            t = 0
        end
    end
end)

-- Fly
local flyBV, flyBG
local function setFly(on)
    State.Fly = on
    local root = hrp()
    if on then
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyBG.P = 9e4
        flyBG.Parent = root
        char():FindFirstChildOfClass("Humanoid").PlatformStand = true
    else
        if flyBV then flyBV:Destroy() end
        if flyBG then flyBG:Destroy() end
        local h = char():FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

RunService.RenderStepped:Connect(function()
    if not State.Fly or not flyBV then return end
    local cam = workspace.CurrentCamera
    local dir = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
    -- tren mobile: dung huong di chuyen cua Humanoid
    local h = char():FindFirstChildOfClass("Humanoid")
    if dir.Magnitude == 0 and h and h.MoveDirection.Magnitude > 0 then
        dir = cam.CFrame:VectorToWorldSpace(
            Vector3.new(h.MoveDirection.X, 0, h.MoveDirection.Z)).Unit
        dir = Vector3.new(h.MoveDirection.X, cam.CFrame.LookVector.Y * h.MoveDirection.Magnitude, h.MoveDirection.Z)
    end
    flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * FLY_SPEED or Vector3.zero
    flyBG.CFrame = cam.CFrame
end)

lp.CharacterAdded:Connect(function() State.Fly = false end)

-- Tele Tool (bam vao dau teleport toi do)
local function giveTeleTool()
    if lp.Backpack:FindFirstChild("TeleTool") then return end
    local tool = Instance.new("Tool")
    tool.Name = "TeleTool"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Activated:Connect(function()
        local mouse = lp:GetMouse()
        if mouse.Hit then
            hrp().CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 4, 0))
        end
    end)
    tool.Parent = lp.Backpack
end

-- Auto Pray: tim ProximityPrompt / ClickDetector co ten chua "pray"
local function fireByName(keyword)
    for _, d in ipairs(workspace:GetDescendants()) do
        local n = d.Name:lower()
        local parentName = d.Parent and d.Parent.Name:lower() or ""
        if n:find(keyword) or parentName:find(keyword) then
            if d:IsA("ProximityPrompt") and fireproximityprompt then
                pcall(fireproximityprompt, d)
            elseif d:IsA("ClickDetector") and fireclickdetector then
                pcall(fireclickdetector, d)
            end
        end
    end
end

task.spawn(function()
    while task.wait(2) do
        if State.Pray then pcall(fireByName, "pray") end
    end
end)

-- Auto Pumpkin: cham vao part ten "pumpkin"
task.spawn(function()
    while task.wait(0.5) do
        if State.Pumpkin then
            pcall(function()
                local root = hrp()
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d:IsA("BasePart") and d.Name:lower():find("pumpkin") then
                        if firetouchinterest then
                            firetouchinterest(root, d, 0)
                            firetouchinterest(root, d, 1)
                        else
                            root.CFrame = d.CFrame
                            task.wait(0.15)
                        end
                    end
                    local pp = d:IsA("ProximityPrompt") and d
                    if pp and pp.Parent and pp.Parent.Name:lower():find("pumpkin") and fireproximityprompt then
                        fireproximityprompt(pp)
                    end
                end
            end)
        end
    end
end)

-- Nhap code: thu ten remote pho bien. Sua REDEEM_REMOTE neu biet ten that.
local REDEEM_REMOTE = nil -- vd: game.ReplicatedStorage.Remotes.RedeemCode
local function redeem(code)
    if REDEEM_REMOTE then
        pcall(function() REDEEM_REMOTE:FireServer(code) end)
        return
    end
    for _, d in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name:lower():find("code") then
            pcall(function() d:FireServer(code) end)
        end
    end
end

