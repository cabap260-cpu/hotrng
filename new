local function TriggerInteract(obj)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    local clicker = obj:FindFirstChildWhichIsA("ClickDetector", true)
    local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)

    if targetPart then
        root.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.2)
    end

    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration + 0.1)
            prompt:InputHoldEnd()
        end
    elseif clicker and fireclickdetector then
        fireclickdetector(clicker)
    end
end

-- Vòng lặp Auto Pray
task.spawn(function()
    while task.wait(2) do
        if State.AutoPray then
            pcall(function()
                for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                    if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and 
                       (string.find(string.lower(v.Name), "pray") or string.find(string.lower(v.Name), "shrine")) then
                        if v:IsA("RemoteEvent") then v:FireServer() else v:InvokeServer() end
                    end
                end

                for _, obj in pairs(Workspace:GetDescendants()) do
                    local name = string.lower(obj.Name)
                    if (string.find(name, "pray") or string.find(name, "shrine") or string.find(name, "altar")) and 
                       (obj:IsA("Model") or obj:IsA("BasePart")) then
                        if obj:FindFirstChildWhichIsA("ProximityPrompt", true) or obj:FindFirstChildWhichIsA("ClickDetector", true) then
                            TriggerInteract(obj)
                            break
                        end
                    end
                end
            end)
        end
    end
end)

-- Vòng lặp Auto Collect Pumpkin
task.spawn(function()
    while task.wait(0.5) do
        if State.AutoPumpkin then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end

                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not State.AutoPumpkin then break end
                    local name = string.lower(obj.Name)
                    if (string.find(name, "pumpkin") or string.find(name, "pumkin")) and 
                       (obj:IsA("BasePart") or obj:IsA("Model")) then
                        
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                        if part and part.Parent then
                            root.CFrame = part.CFrame + Vector3.new(0, 2, 0)
                            
                            if firetouchinterest then
                                firetouchinterest(root, part, 0)
                                task.wait(0.05)
                                firetouchinterest(root, part, 1)
                            end

                            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt then
                                if fireproximityprompt then
                                    fireproximityprompt(prompt)
                                else
                                    prompt:InputHoldBegin()
                                    task.wait(prompt.HoldDuration)
                                    prompt:InputHoldEnd()
                                end
                            end
                            task.wait(0.25)
                        end
                    end
                end
            end)
        end
    end
end)

