-- 4. TELE TOOL (Chạm màn hình để Teleport)
--==================================================
local function giveTeleTool()
    local bp = lp:WaitForChild("Backpack")
    if bp:FindFirstChild("TeleTool") or (lp.Character and lp.Character:FindFirstChild("TeleTool")) then
        return
    end
    local tool = Instance.new("Tool")
    tool.Name = "TeleTool"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Activated:Connect(function()
        local mouse = lp:GetMouse()
        local root = getHRP()
        if root and mouse and mouse.Hit then
            root.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 4, 0))
        end
    end)
    tool.Parent = bp
end

--==================================================
-- 5. AUTO PRAY & AUTO PUMPKIN
--==================================================
local function fireByName(keyword)
    local root = getHRP()
    for _, d in ipairs(workspace:GetDescendants()) do
        local n = d.Name:lower()
        local parentName = (d.Parent and d.Parent.Name:lower()) or ""
        if n:find(keyword, 1, true) or parentName:find(keyword, 1, true) then
            if d:IsA("ProximityPrompt") then
                if fireproximityprompt then
                    pcall(fireproximityprompt, d)
                else
                    local part = d.Parent and (d.Parent:IsA("BasePart") and d.Parent or d.Parent:FindFirstChildWhichIsA("BasePart"))
                    if root and part then root.CFrame = part.CFrame + Vector3.new(0, 3, 0) end
                    d:InputHoldBegin()
                    task.wait(d.HoldDuration)
                    d:InputHoldEnd()
                end
            elseif d:IsA("ClickDetector") and fireclickdetector then
                pcall(fireclickdetector, d)
            end
        end
    end
end

task.spawn(function()
    while task.wait(2) do
        if State.Pray then
            pcall(fireByName, "pray")
        end
    end
end)

task.spawn(function()
    while task.wait(1) do
        if State.Pumpkin then
            pcall(function()
                local root = getHRP()
                if not root then return end
                for _, d in ipairs(workspace:GetDescendants()) do
                    if not State.Pumpkin then break end
                    local name = d.Name:lower()
                    if d:IsA("BasePart") and (name:find("pumpkin", 1, true) or name:find("pumkin", 1, true)) then
                        if firetouchinterest then
                            pcall(firetouchinterest, root, d, 0)
                            pcall(firetouchinterest, root, d, 1)
                        else
                            root.CFrame = d.CFrame + Vector3.new(0, 2, 0)
                            task.wait(0.2)
                        end
                    elseif d:IsA("ProximityPrompt") and d.Parent then
                        local pName = d.Parent.Name:lower()
                        if (pName:find("pumpkin", 1, true) or pName:find("pumkin", 1, true)) and fireproximityprompt then
                            pcall(fireproximityprompt, d)
                        end
                    end
                end
            end)
        end
    end
end)

--==================================================
-- 6. REDEEM CODE
--==================================================
local REDEEM_REMOTE = nil
local function redeem(code)
    if REDEEM_REMOTE then
        pcall(function() REDEEM_REMOTE:FireServer(code) end)
        return
    end
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name:lower():find("code", 1, true) then
            pcall(function() d:FireServer(code) end)
        elseif d:IsA("RemoteFunction") and d.Name:lower():find("code", 1, true) then
            pcall(function() d:InvokeServer(code) end)
        end
    end
end

