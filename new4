local function mk(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    return o
end

local function toggle(text, key, onChange, warnColor)
    local b = mk("TextButton", {
        Size = UDim2.new(1, -16, 0, 28), BackgroundColor3 = Color3.fromRGB(50, 50, 62),
        TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Gotham, TextSize = 13,
        BorderSizePixel = 0, Parent = body,
    })
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local onColor = warnColor or Color3.fromRGB(40, 140, 70)
    local function refresh()
        b.Text = text .. ": " .. (State[key] and "ON" or "OFF")
        b.BackgroundColor3 = State[key] and onColor or Color3.fromRGB(50, 50, 62)
    end
    b.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        if onChange then onChange(State[key]) end
        refresh()
    end)
    refresh()
    return b
end

local function button(text, cb, color)
    local b = mk("TextButton", {
        Size = UDim2.new(1, -16, 0, 28), BackgroundColor3 = color or Color3.fromRGB(60, 80, 140),
        Text = text, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Gotham,
        TextSize = 13, BorderSizePixel = 0, Parent = body,
    })
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(cb)
    return b
end

