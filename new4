---------------------------------------------------------------- GUI-text notification watcher (PlayerGui)
do
    local PG = LP:WaitForChild("PlayerGui")
    local function hookText(d)
        if not (d:IsA("TextLabel") or d:IsA("TextButton")) then return end
        if d:IsDescendantOf(gui) then return end
        pcall(function()
            track(d:GetPropertyChangedSignal("Text"):Connect(function()
                if d.Text ~= "" and matches(d.Text, CONFIG.PRAY_NOTICE_PATTERNS) then
                    setNotice(d.Text)
                end
            end))
        end)
    end
    for _, d in ipairs(PG:GetDescendants()) do hookText(d) end
    track(PG.DescendantAdded:Connect(function(d)
        task.defer(function()
            hookText(d)
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and not d:IsDescendantOf(gui)
               and d.Text ~= "" and matches(d.Text, CONFIG.PRAY_NOTICE_PATTERNS) then
                setNotice(d.Text) -- thông báo mới được clone vào GUI
            end
        end)
    end))
end

