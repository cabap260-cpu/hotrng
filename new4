---------------------------------------------------------------- helpers: scan / fire / walk
local function fireTarget(inst)
    if inst:IsA("ProximityPrompt") then
        if fireproximityprompt then fireproximityprompt(inst) return true end
    elseif inst:IsA("ClickDetector") then
        if fireclickdetector then fireclickdetector(inst) return true end
    end
    return false
end

local function findInteractables(patterns, scope)
    local out = {}
    for _, d in ipairs(scope:GetDescendants()) do
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
            local p = d.Parent
            if matches(d.Name, patterns) or (p and matches(p.Name, patterns))
               or (p and p.Parent and matches(p.Parent.Name, patterns)) then
                out[#out+1] = d
            end
        end
    end
    return out
end

local function findRemotes(patterns)
    local out = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and matches(d.Name, patterns) then
            out[#out+1] = d
        end
    end
    return out
end

local function partOf(inst)
    if inst:IsA("BasePart") then return inst end
    local p = inst.Parent
    while p and not p:IsA("BasePart") do
        if p:IsA("Model") then return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
        p = p.Parent
    end
    return p
end

-- Đi bộ thật bằng Humanoid:MoveTo (không đổi CFrame, không teleport)
local function walkTo(part, stopDist, timeout)
    if State.Fly then log("tắt Fly để tự đi bộ") return false end
    local hrp, hum = root()
    if not (hrp and hum and part) then return false end
    local t0 = tick()
    while alive and tick() - t0 < timeout do
        hrp, hum = root()
        if not (hrp and hum and part.Parent) then return false end
        if (hrp.Position - part.Position).Magnitude <= stopDist then
            hum:MoveTo(hrp.Position)
            return true
        end
        hum:MoveTo(part.Position)
        task.wait(0.25)
    end
    return false
end

---------------------------------------------------------------- Pray notification detector
local prayNotice = { t = 0, text = "" }
local function setNotice(text)
    prayNotice.t = tick()
    prayNotice.text = tostring(text)
    log("notice: " .. prayNotice.text)
end

local function argsToStr(...)
    local t = {}
    for i = 1, select("#", ...) do t[#t+1] = tostring((select(i, ...))) end
    return string.sub(table.concat(t, ", "), 1, 90)
end

-- RemoteEvent từ server (thông báo thường đi qua đây)
local function hookRemote(r)
    if not r:IsA("RemoteEvent") then return end
    pcall(function()
        track(r.OnClientEvent:Connect(function(...)
            if State.Spy then log("[S] " .. r.Name .. "(" .. argsToStr(...) .. ")") end
            for i = 1, select("#", ...) do
                local a = select(i, ...)
                if type(a) == "string" and matches(a, CONFIG.PRAY_NOTICE_PATTERNS) then
                    setNotice(a)
                    break
                end
            end
        end))
    end)
end
for _, d in ipairs(ReplicatedStorage:GetDescendants()) do hookRemote(d) end
track(ReplicatedStorage.DescendantAdded:Connect(hookRemote))

