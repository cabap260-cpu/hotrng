local function queueReload()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport)
    if not q then return end
    local code
    if CONFIG.SCRIPT_URL ~= "" then
        code = ('loadstring(game:HttpGet("%s"))()'):format(CONFIG.SCRIPT_URL)
