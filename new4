---------------------------------------------------------------- log
local logLabel
local logHistory = {}
local function log(msg)
    msg = tostring(msg)
    logHistory[#logHistory+1] = os.date("%H:%M:%S") .. " " .. msg
    if #logHistory > 80 then table.remove(logHistory, 1) end
    if logLabel then logLabel.Text = "Log: " .. msg end
end

local function lower(s) return string.lower(tostring(s)) end
local function matches(name, patterns)
    local n = lower(name)
    for _, p in ipairs(patterns) do if string.find(n, p, 1, true) then return true end end
    return false
end
local function rand(a, b) return a + math.random() * (b - a) end
local function jitter(base, pct) return base * (1 + (math.random() * 2 - 1) * pct) end
local function root()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

